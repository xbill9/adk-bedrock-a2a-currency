# --- Coordinator (Google ADK on Cloud Run) ---
GENAI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_API_KEY comes from Secret Manager at deploy time; never put it here.

# Remote worker: the AgentCore runtime's A2A endpoint (printed by `agentcore status`)
CURRENCY_A2A_ENDPOINT=https://REPLACE
# Must match allowedAudience in agentcore/agentcore.json. The coordinator asks
# the GCP metadata server for an ID token with exactly this audience.
CURRENCY_A2A_AUDIENCE=currencybench-agentcore-worker
# Fail closed: a2a_only and verified refuse to fall back to a local fixture.
CURRENCY_REQUIRE_AWS_AGENTCORE=1
# Escape hatch for laptop testing; bypasses the metadata server.
# CURRENCY_A2A_BEARER_TOKEN=

# MCP exchange-rate baseline
CURRENCY_RATE_PROVIDER=frankfurter
CURRENCY_RATE_TRANSPORT=mcp-stdio
CURRENCY_TIMEOUT_SECONDS=60

# --- Worker (Strands on Bedrock AgentCore) ---
# Deployed values live in agentcore/agentcore.json runtimes[0].envVars.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0

# --- Benchmark driver ---
# Cloud Run URL of the coordinator; used by evaluations/invoke_hosted.py
CURRENCY_COORDINATOR_ENDPOINT=https://REPLACE
# Only needed if the Cloud Run service is deployed without --allow-unauthenticated:
#   export CURRENCY_COORDINATOR_TOKEN=$(gcloud auth print-identity-token)
# CURRENCY_COORDINATOR_TOKEN=

# Runtime
APP_ENV=development
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=adk-bedrock-a2a-currency
