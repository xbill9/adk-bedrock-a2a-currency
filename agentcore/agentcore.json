{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "currencybench",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "currencybench"
  },
  "runtimes": [
    {
      "name": "CurrencyWorker",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/CurrencyWorker/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "A2A",
      "authorizerType": "AWS_IAM",
      "envVars": [
        { "name": "BEDROCK_MODEL_ID", "value": "us.amazon.nova-micro-v1:0" },
        { "name": "BEDROCK_MAX_TOKENS", "value": "1024" },
        { "name": "CURRENCY_RATE_PROVIDER", "value": "frankfurter" }
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}
